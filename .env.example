# Neon Postgres connection string (pooled or direct both work)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/medflow?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: send real emails via Resend. Without it, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="MedFlow <appointments@example.com>"
